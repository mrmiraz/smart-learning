# Copy to .env. Never commit .env.
# Use a long passphrase: the encrypted pages are public, so a short password can be brute-forced offline.
ACCESS_PASSWORD=change-me-to-a-long-passphrase

# Optional: the public address of the published site, baked into the QR codes.
# On GitHub Pages the deploy workflow sets this for you. Leave empty to use the address the page is opened at.
PUBLIC_URL=
