    {
      "id": "demos",
      "label": "Demos",
      "minutes": 60,
      "steps": [
        {
          "type": "concept",
          "concept": "demo",
          "title": "walkthrough: addressing modes",
          "blocks": [
            {
              "type": "walkthrough",
              "title": "Effective address",
              "modes": [
                {
                  "name": "Base + displacement",
                  "inputs": [
                    {
                      "id": "base",
                      "label": "Base register $s1",
                      "value": 4096,
                      "min": 0,
                      "max": 8192,
                      "step": 4
                    },
                    {
                      "id": "off",
                      "label": "Offset",
                      "value": 8,
                      "min": -16,
                      "max": 64,
                      "step": 4
                    }
                  ],
                  "stages": [
                    {
                      "label": "Instruction",
                      "text": "`lw $t0, {off}($s1)`"
                    },
                    {
                      "label": "Address calculation",
                      "text": "{base} + {off} = **{base+off}** ({base+off|hex8})"
                    },
                    {
                      "label": "Memory",
                      "text": "Read the word at {base+off|hex8}"
                    },
                    {
                      "label": "Data",
                      "text": "The word goes to `$t0`"
                    }
                  ],
                  "note": "The effective address is the base plus the sign-extended offset."
                },
                {
                  "name": "PC-relative branch",
                  "inputs": [
                    {
                      "id": "pc",
                      "label": "PC of the branch",
                      "value": 4194304,
                      "min": 4194304,
                      "max": 4194400,
                      "step": 4
                    },
                    {
                      "id": "w",
                      "label": "Offset field (words)",
                      "value": 3,
                      "min": -8,
                      "max": 8,
                      "step": 1
                    }
                  ],
                  "stages": [
                    {
                      "label": "Branch at",
                      "text": "PC = {pc|hex8}"
                    },
                    {
                      "label": "PC + 4",
                      "text": "{pc+4|hex8}"
                    },
                    {
                      "label": "Offset in bytes",
                      "text": "{w} words × 4 = {w*4} bytes"
                    },
                    {
                      "label": "Target",
                      "text": "**{pc+4+w*4|hex8}**"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "concept",
          "concept": "demo",
          "title": "bits: number representation",
          "blocks": [
            {
              "type": "bits",
              "title": "Number representation",
              "modes": [
                "twos",
                "add",
                "ieee",
                "endian",
                "mul",
                "div"
              ]
            }
          ]
        },
        {
          "type": "concept",
          "concept": "demo",
          "title": "encoder: instruction builder",
          "blocks": [
