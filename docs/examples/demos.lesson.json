          ]
        },
        {
          "type": "concept",
          "concept": "demo",
          "title": "mips: simulator",
          "blocks": [
            {
              "type": "mips",
              "title": "Sum 1 to 10",
              "editable": true,
              "program": "li $t0, 0\nli $t1, 1\nloop: add $t0, $t0, $t1\naddi $t1, $t1, 1\nslti $t2, $t1, 11\nbne $t2, $zero, loop\nsw $t0, 0($s1)",
              "registers": {
                "$s1": 268500992
              },
              "watch": [
                "$t0",
                "$t1",
                "$t2",
                "$s1"
              ]
            }
          ]
        },
        {
          "type": "concept",
          "concept": "demo",
          "title": "diagram: datapath fragment",
          "blocks": [
            {
              "type": "diagram",
              "title": "A tiny datapath",
              "width": 820,
              "height": 300,
              "nodes": [
                {
                  "id": "pc",
