                  "id": "e_pc_add",
                  "points": [
                    [
                      55,
                      170
                    ],
                    [
                      55,
                      72
                    ],
                    [
                      60,
                      72
                    ]
                  ],
                  "arrow": false
                },
                {
                  "id": "e_add_pc",
                  "points": [
                    [
                      120,
                      72
                    ],
                    [
                      160,
                      72
                    ],
                    [
                      160,
                      120
                    ],
                    [
                      10,
                      120
                    ],
                    [
                      10,
                      200
                    ],
                    [
                      20,
                      200
                    ]
                  ],
                  "label": "PC + 4",
                  "labelAt": [
                    85,
                    112
                  ]
                }
              ],
              "labels": [
                {
                  "x": 410,
                  "y": 290,
                  "text": "(fragment: build step by step, then run an instruction)"
                }
              ],
              "steps": [
                {
                  "show": [
                    "pc",
                    "e_pc_im",
                    "im"
                  ],
                  "text": "First the **PC** and the instruction memory."
                },
                {
                  "show": [
                    "rf",
                    "e_im_rf"
                  ],
                  "text": "The instruction names registers in the **register file**."
                },
                {
                  "show": [
                    "alu",
                    "e_rf_alu"
                  ],
                  "text": "The **ALU** computes."
                },
                {
                  "show": [
                    "dm",
                    "e_alu_dm",
                    "add4",
                    "e_pc_add",
                    "e_add_pc"
                  ],
                  "text": "Data memory and the PC update complete the picture."
                }
              ],
              "scenarios": [
                {
                  "name": "add $s0, $s1, $s2",
                  "steps": [
                    {
                      "highlight": [
                        "pc",
                        "e_pc_im",
                        "im"
                      ],
                      "text": "**Fetch**: the PC addresses the instruction memory.",
                      "values": {
                        "pc": "0x00400000"
                      }
                    },
                    {
                      "highlight": [
                        "im",
                        "e_im_rf",
                        "rf"
                      ],
                      "text": "**Decode**: read $s1 and $s2.",
                      "values": {
                        "rf": "$s1=5, $s2=7"
                      }
                    },
                    {
                      "highlight": [
                        "rf",
                        "e_rf_alu",
                        "alu"
                      ],
                      "text": "**Execute**: the ALU adds 5 + 7.",
                      "values": {
                        "alu": "12"
                      }
                    },
                    {
                      "highlight": [
                        "add4",
                        "e_pc_add",
                        "e_add_pc",
                        "pc"
                      ],
                      "text": "The PC moves to PC + 4."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "concept",
          "concept": "demo",
          "title": "pipeline: hazard simulator",
          "blocks": [
            {
              "type": "pipeline",
              "title": "Pipeline timing",
              "controls": [
                "forwarding",
                "branch",
                "memory",
                "compare"
              ],
              "scenarios": [
                {
                  "name": "Independent",
                  "instructions": [
                    "add $s0,$s1,$s2",
                    "sub $s3,$s4,$s5",
                    "and $s6,$s7,$t0",
                    "or $t1,$t2,$t3"
                  ],
                  "note": "No dependences: one instruction completes per cycle once the pipeline is full."
                },
                {
                  "name": "Load-use",
                  "instructions": [
                    "lw $t0, 0($s0)",
                    "add $t1,$t0,$t2",
                    "sub $t3,$t1,$t4"
                  ],
                  "note": "Even with forwarding, a load followed by a user of the loaded value needs one stall."
                },
                {
                  "name": "Branch",
                  "instructions": [
                    "add $t1,$s1,$s2",
                    {
                      "t": "beq $t1,$t2,L",
                      "taken": true
                    },
                    "add $s0,$s1,$s2",
                    "sub $s3,$s4,$s5"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "concept",
