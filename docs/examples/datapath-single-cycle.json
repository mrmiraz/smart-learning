  "steps": [
    {
      "show": [
        "pc",
        "im",
        "e_pc_im"
      ],
      "text": "The **program counter** holds the address of the instruction. It addresses the **instruction memory**."
    },
    {
      "show": [
        "rf",
        "e_im_rs",
        "e_im_rt",
        "regdst",
        "e_im_regdst",
        "e_regdst_rf"
      ],
      "text": "Fields of the instruction name the registers to read in the **register file**; a multiplexer picks the destination register."
    },
    {
      "show": [
        "alu",
        "alusrc",
        "e_rf_alu",
        "e_rf_alusrc",
        "e_alusrc_alu"
      ],
      "text": "The **ALU** operates on register data, or on register data and an immediate chosen by a multiplexer."
    },
    {
      "show": [
        "signext",
        "e_im_signext",
        "e_signext_alusrc"
      ],
      "text": "The 16-bit immediate is **sign-extended** to 32 bits so it can be an ALU input."
    },
    {
      "show": [
        "dm",
        "e_alu_dm",
        "e_rf_dm",
        "memtoreg",
        "e_alu_memtoreg",
        "e_dm_memtoreg",
        "e_memtoreg_rf"
      ],
      "text": "**Data memory** is read or written for loads and stores; a multiplexer chooses what is written back to the register file."
    },
    {
      "show": [
        "add4",
        "e_pc_add4",
        "e_add4_pcsrc",
        "pcsrc",
        "e_pcsrc_pc"
      ],
      "text": "The PC normally advances by 4 to the next instruction."
    },
    {
      "show": [
        "shift",
        "badd",
        "e_add4_badd",
        "e_shift_badd",
        "e_badd_pcsrc",
        "e_signext_shift",
        "e_zero"
      ],
      "text": "For branches, a second adder computes the **branch target** and the ALU's Zero output helps choose the next PC."
    },
    {
      "show": [
        "ctrl",
        "e_im_ctrl"
      ],
      "text": "The **control unit** reads the opcode and sets every multiplexer and memory control signal."
    }
  ],
  "scenarios": [
    {
      "name": "add $t0, $s1, $s2",
      "steps": [
        {
          "highlight": [
            "pc",
            "e_pc_im",
            "im"
          ],
          "text": "**Fetch**: the PC addresses the instruction memory and the instruction is read.",
          "values": {
            "pc": "0x00400000",
            "im": "add $t0,$s1,$s2"
          }
        },
        {
          "highlight": [
            "im",
            "e_im_rs",
            "e_im_rt",
            "rf",
            "e_im_ctrl",
            "ctrl"
          ],
          "text": "**Decode**: the control unit sets the signals for an R-type instruction; registers $s1 and $s2 are read.",
          "values": {
            "rf": "$s1=5  $s2=7",
            "ctrl": "RegDst=1 ALUSrc=0 RegWrite=1"
          }
        },
        {
          "highlight": [
            "rf",
            "e_rf_alu",
            "e_rf_alusrc",
            "alusrc",
            "e_alusrc_alu",
            "alu"
          ],
          "text": "**Execute**: the ALU adds the two register values.",
          "values": {
            "alu": "5 + 7 = 12",
            "alusrc": "ALUSrc=0"
          }
        },
        {
          "highlight": [
            "alu",
            "e_alu_memtoreg",
            "memtoreg",
            "e_memtoreg_rf",
            "rf",
            "regdst",
            "e_regdst_rf"
          ],
          "text": "**Write back**: the ALU result (not memory data) goes to the destination register $t0.",
          "values": {
            "memtoreg": "MemtoReg=0",
            "rf": "$t0 = 12"
          }
        },
        {
          "highlight": [
            "pc",
            "add4",
            "e_pc_add4",
            "e_add4_pcsrc",
            "pcsrc",
            "e_pcsrc_pc"
          ],
          "text": "**Next instruction**: PC + 4 becomes the new PC.",
          "values": {
            "pc": "0x00400004"
          }
        }
      ]
    },
    {
      "name": "lw $t0, 8($s1)",
      "steps": [
        {
          "highlight": [
            "pc",
            "e_pc_im",
            "im"
          ],
          "text": "**Fetch** the load instruction.",
          "values": {
            "im": "lw $t0,8($s1)"
          }
        },
        {
          "highlight": [
            "im",
            "e_im_rs",
            "rf",
            "e_im_signext",
            "signext",
            "e_im_ctrl",
            "ctrl"
          ],
          "text": "**Decode**: read the base register $s1; sign-extend the offset 8.",
          "values": {
            "rf": "$s1=0x1000",
            "signext": "8",
            "ctrl": "ALUSrc=1 MemRead=1 RegWrite=1"
          }
        },
        {
          "highlight": [
            "rf",
            "e_rf_alu",
            "signext",
            "e_signext_alusrc",
            "alusrc",
            "e_alusrc_alu",
            "alu"
          ],
          "text": "**Execute**: the ALU adds the base and the offset to form the **address**.",
          "values": {
            "alu": "0x1000 + 8 = 0x1008"
          }
        },
        {
          "highlight": [
            "alu",
            "e_alu_dm",
            "dm"
          ],
          "text": "**Memory access**: data memory is read at that address.",
          "values": {
            "dm": "Mem[0x1008] = 42"
          }
        },
        {
          "highlight": [
            "dm",
            "e_dm_memtoreg",
            "memtoreg",
            "e_memtoreg_rf",
            "rf",
            "e_im_regdst",
            "regdst",
            "e_regdst_rf"
          ],
          "text": "**Write back**: the loaded value goes to $t0 (here MemtoReg = 1, RegDst = 0).",
          "values": {
            "memtoreg": "MemtoReg=1",
            "rf": "$t0 = 42"
          }
        }
      ]
    },
    {
      "name": "sw $t0, 8($s1)",
      "steps": [
        {
          "highlight": [
            "pc",
            "e_pc_im",
            "im"
          ],
          "text": "**Fetch** the store instruction.",
          "values": {
            "im": "sw $t0,8($s1)"
          }
        },
        {
          "highlight": [
            "im",
            "e_im_rs",
            "e_im_rt",
            "rf",
            "signext",
            "e_im_signext",
            "e_im_ctrl",
            "ctrl"
          ],
          "text": "**Decode**: read $s1 (base) and $t0 (the value to store); sign-extend the offset.",
          "values": {
            "ctrl": "ALUSrc=1 MemWrite=1 RegWrite=0"
          }
        },
        {
          "highlight": [
            "rf",
            "e_rf_alu",
            "signext",
            "e_signext_alusrc",
            "alusrc",
            "e_alusrc_alu",
            "alu"
          ],
          "text": "**Execute**: compute the address base + offset.",
          "values": {
            "alu": "0x1000 + 8 = 0x1008"
          }
        },
        {
          "highlight": [
            "alu",
            "e_alu_dm",
            "e_rf_dm",
            "dm"
          ],
          "text": "**Memory access**: the register value is **written** to data memory. Nothing is written back to a register.",
          "values": {
            "dm": "Mem[0x1008] = $t0"
          }
        }
      ]
    },
    {
      "name": "beq $s1, $s2, L",
      "steps": [
        {
          "highlight": [
            "pc",
            "e_pc_im",
            "im"
          ],
          "text": "**Fetch** the branch instruction.",
          "values": {
            "im": "beq $s1,$s2,L"
          }
        },
        {
          "highlight": [
            "im",
            "e_im_rs",
            "e_im_rt",
            "rf",
            "e_im_signext",
            "signext",
            "e_im_ctrl",
            "ctrl"
          ],
          "text": "**Decode**: read the two registers to compare; sign-extend the offset.",
          "values": {
            "ctrl": "Branch=1 ALUSrc=0 RegWrite=0"
          }
        },
        {
          "highlight": [
            "rf",
            "e_rf_alu",
            "e_rf_alusrc",
            "alusrc",
            "e_alusrc_alu",
            "alu",
            "e_zero"
          ],
          "text": "**Execute**: the ALU subtracts the registers. If they are equal the result is zero and the **Zero** output is 1.",
          "values": {
            "alu": "5 - 5 = 0, Zero = 1"
          }
        },
        {
          "highlight": [
            "signext",
            "e_signext_shift",
            "shift",
            "e_shift_badd",
            "add4",
            "e_add4_badd",
            "badd",
            "e_badd_pcsrc"
          ],
          "text": "At the same time the **branch adder** computes PC + 4 + (offset × 4).",
          "values": {
            "badd": "branch target"
          }
        },
        {
          "highlight": [
            "e_zero",
            "pcsrc",
            "e_badd_pcsrc",
            "e_pcsrc_pc",
            "pc"
          ],
          "text": "Branch AND Zero selects the branch target as the **next PC** (PCSrc = 1).",
          "values": {
            "pcsrc": "PCSrc=1"
          }
        }
      ]
    }
  ]
}