    "audit:mobile": "node --env-file=.env scripts/responsive-audit.js",
    "test": "node --test"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "reveal.js": "^6.0.2",
    "staticrypt": "^3.5.4"
  }
}
